{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackaft.com/schemas/manifest.v1.json",
  "title": "BlackaftManifest",
  "description": "JSON-RPC 2.0 / MCP-compliant boilerplate schema for Blackaft index.json manifests.",
  "type": "object",
  "required": ["jsonrpc", "id", "result"],
  "additionalProperties": false,
  "properties": {
    "jsonrpc": {
      "type": "string",
      "const": "2.0",
      "description": "JSON-RPC version specification."
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the manifest instance."
    },
    "result": {
      "type": "object",
      "required": ["serverInfo", "capabilities", "prompts", "tools", "resources"],
      "additionalProperties": false,
      "properties": {
        "serverInfo": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "description": "Skill/Module namespace (e.g., 'blackaft', 'blackaft-billables')."
            },
            "version": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "SemVer string."
            },
            "description": {
              "type": "string"
            }
          }
        },
        "capabilities": {
          "type": "object",
          "description": "MCP capability declarations.",
          "additionalProperties": true
        },
        "prompts": {
          "type": "array",
          "description": "System meta-prompts and instructions dynamically ingested by AI agents.",
          "items": {
            "$ref": "#/definitions/McpPrompt"
          }
        },
        "tools": {
          "type": "array",
          "description": "Deterministic handlers and script execution triggers.",
          "items": {
            "$ref": "#/definitions/McpTool"
          }
        },
        "resources": {
          "type": "array",
          "description": "Static and dynamic asset URI references (Vaults, Repos, Schemas).",
          "items": {
            "$ref": "#/definitions/McpResource"
          }
        }
      }
    }
  },
  "definitions": {
    "McpPrompt": {
      "type": "object",
      "required": ["name", "prompt"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Prompt reference identifier (e.g., 'storytelling_meta')."
        },
        "description": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "required": { "type": "boolean" }
            }
          }
        },
        "prompt": {
          "type": "string",
          "description": "The raw meta-prompt string loaded by the agent upon tool commitment."
        }
      }
    },
    "McpTool": {
      "type": "object",
      "required": ["name", "description", "inputSchema", "_handler"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Tool capability name matching SKILL.md."
        },
        "description": {
          "type": "string"
        },
        "inputSchema": {
          "type": "object",
          "description": "JSON Schema object defining tool arguments.",
          "required": ["type", "properties"],
          "properties": {
            "type": { "type": "string", "const": "object" },
            "properties": { "type": "object" },
            "required": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "_handler": {
          "type": "object",
          "description": "Blackaft deterministic runtime execution instructions.",
          "required": ["type", "entrypoint"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["cli", "python", "shell", "http", "mcp"]
            },
            "entrypoint": {
              "type": "string",
              "description": "Relative path to executable script or handler."
            },
            "required_skills": {
              "type": "array",
              "items": { "type": "string" }
            },
            "vaults": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "McpResource": {
      "type": "object",
      "required": ["uri", "name"],
      "additionalProperties": false,
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri",
          "description": "Resource identifier (e.g., 'blackaft://vaults/creative')."
        },
        "name": {
          "type": "string"
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type (e.g., 'application/json', 'text/x-yaml')."
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}